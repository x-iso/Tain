<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    Per-monitor DPI awareness, declared where nothing can lose a race to it.

    Windows settles a process's DPI awareness the first time it is asked
    something that depends on it, and after that `SetProcessDpiAwarenessContext`
    fails. Calling it first in `main` was an improvement and still a race: the
    loader, the C runtime and anything linked ahead of us all run first, and a
    process that ends up merely *system* aware is told the primary monitor's DPI
    everywhere and bitmap-stretched onto every other one — which looks like the
    interface stepping back to the main monitor's scale, with the stretching
    visible as artefacts.

    A manifest is applied by the loader before any of that. It cannot be
    overridden by call order, and it is what Microsoft documents as the way to
    declare this.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11, which is what PerMonitorV2 needs. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
